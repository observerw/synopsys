# Synopsys VCS X-2025.06-SP1 (linux64), license checked out from a remote
# SCL/FlexLM server.  The image contains no license server and no license file.
#
# Both stages come from base/ (see base/Containerfile.build / .runtime):
#   build:8.10   Synopsys Installer in /opt/synopsys-installer,
#                    ValidationTool on PATH, SI_ACCEPT_LICENSE=1
#   runtime:8.10 X11/GL/libstdc++/FlexLM runtime libraries
#
# The linux64 EST image ships as three .spf.partNN volumes.  batch_installer
# regenerates the .spf itself through the Installer's joinEst.sh, verifying the
# per-volume and whole-file checksums from each volume header.
ARG EDABASE=local.io/synopsys
ARG BUILD_IMAGE=${EDABASE}/build:8.10
ARG RUNTIME_IMAGE=${EDABASE}/runtime:8.10

FROM ${BUILD_IMAGE} AS build

COPY vcs_vX-2025.06-SP1_common.spf \
     vcs_vX-2025.06-SP1_linux64.spf.part00 \
     vcs_vX-2025.06-SP1_linux64.spf.part01 \
     vcs_vX-2025.06-SP1_linux64.spf.part02 \
     /tmp/src/

# VCS's post-install hook prints warnings for optional site info; the installed
# tree is what matters, so capture the installer log and gate on that.
RUN /opt/synopsys-installer/batch_installer -allprods -source /tmp/src \
        -target /opt/synopsys -install_as_root > /tmp/install.log 2>&1; \
    rc=$?; tail -30 /tmp/install.log; echo "install_rc=$rc"; \
    test -d /opt/synopsys/vcs/X-2025.06-SP1

# ValidationTool: validate the integrity of the installed Synopsys EDA tools.
RUN ValidationTool -a -d /opt/synopsys/vcs/X-2025.06-SP1

FROM ${RUNTIME_IMAGE}

# The simulator flow compiles DPI/PLI code inside the image, so the toolchain
# from the old runtime stage is kept on top of the shared base.
#
# bin/$VCS_HOME/bin/vcs shells out to `dc` (RecordTime: turns the `times`
# output into seconds) and to /usr/bin/time (the compile-time report), and
# neither exists in runtime: bc ships dc, time ships /usr/bin/time.
#
# `-ntb_opts uvm` (and the VIP setup helpers) run Perl from inside the VCS
# installation wrapper; without it VCS dies with `perl: command not found`
# before it ever adds the UVM include path.
RUN dnf -y --disablerepo='*' --enablerepo=baseos,appstream \
        --setopt=install_weak_deps=False install \
        gcc-c++ make binutils glibc-devel bc time perl \
 && dnf clean all

COPY --from=build /opt/synopsys/vcs/X-2025.06-SP1 /opt/synopsys/vcs/X-2025.06-SP1

ENV VCS_HOME=/opt/synopsys/vcs/X-2025.06-SP1 \
    PATH=/opt/synopsys/vcs/X-2025.06-SP1/bin:$PATH

# --- start probe ----------------------------------------------------------
# Run the packaged probe as the last build step, so a tree that cannot start
# never reaches the registry.  /tmp and /root are tmpfs for this step: the
# tools keep their command logs and license cache there and none of that
# belongs in the image.  Re-run the probe against the finished image with
#   nerdctl run --rm --entrypoint /opt/eda-smoke/smoke.sh <image>
COPY smoke.sh /opt/eda-smoke/smoke.sh
RUN --mount=type=tmpfs,target=/tmp \
    --mount=type=tmpfs,target=/root \
    chmod 0755 /opt/eda-smoke/smoke.sh \
 && /opt/eda-smoke/smoke.sh

# The image entry point is the tool itself, so a pod without a command (or
# `nerdctl run --rm <image> -full64 -f filelist.f`) invokes vcs directly.
# Use `--entrypoint /bin/bash` (or `command: ["bash"]` in a pod) for a shell.
WORKDIR /work
ENTRYPOINT ["vcs"]
