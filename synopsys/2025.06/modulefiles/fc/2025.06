#%Module1.0
proc ModulesHelp { } {
    global version
    puts stderr "Fusion Compiler $version - Synopsys RTL-to-GDSII (fc_shell)."
    puts stderr "Prepends \$root/bin to PATH and preloads libudev for the FlexLM hostid."
}
set version 2025.06
set root /opt/synopsys/fusioncompiler/X-2025.06
module-whatis "Synopsys Fusion Compiler $version"
prepend-path PATH $root/bin
# FC's startup license checkout aborts in lc_checkout's libudev hostid
# enumeration without the preload (fc/2025.06/Containerfile, same as pt/fm/lc).
prepend-path LD_PRELOAD /lib64/libudev.so.1
