#%Module1.0
proc ModulesHelp { } {
    global version
    puts stderr "Formality $version - Synopsys equivalence checking (fm_shell)."
    puts stderr "Prepends \$root/bin to PATH and preloads libudev for the FlexLM hostid."
}
set version 2025.06
set root /opt/synopsys/fm/X-2025.06
module-whatis "Synopsys Formality $version"
prepend-path PATH $root/bin
# Same libudev hostid workaround as PrimeTime (fm/2025.06/Containerfile).
prepend-path LD_PRELOAD /lib64/libudev.so.1
