# Synopsys Library Compiler (LC) 2025.06, license checked out from a remote
# SCL/FlexLM server.  The image contains no license server and no license file.
ARG EDABASE=local.io/synopsys
ARG BUILD_IMAGE=${EDABASE}/build:8.10
ARG RUNTIME_IMAGE=${EDABASE}/runtime:8.10

FROM ${BUILD_IMAGE} AS build

COPY lc_vX-2025.06_common.spf lc_vX-2025.06_linux64.spf /tmp/src/

# LC's post-install hook (install_lc_checkout_license) exits non-zero unless a
# -checkout argument is supplied; the image sets LC_STARTUP_CHECKOUT_LIC=1
# instead, so only the installed tree is required here.
RUN /opt/synopsys-installer/batch_installer -allprods -source /tmp/src \
        -target /opt/synopsys -install_as_root > /tmp/install.log 2>&1; \
    rc=$?; tail -30 /tmp/install.log; echo "install_rc=$rc"; \
    test -d /opt/synopsys/lc/X-2025.06

RUN ValidationTool -a -d /opt/synopsys/lc/X-2025.06

# LC bundles an old libk5crypto/libcrypto OpenSSL 1.1 pair that conflicts with
# the system krb5/OpenSSL; use the matching system pair instead.  LC runs with
# the system OpenSSL only, so every bundled copy goes; fc/pt/fm keep the copies
# their bundled Python/tcl trees use (see README, "Bundled crypto").
RUN find /opt/synopsys/lc/X-2025.06 -name 'libk5crypto.so.3*' -delete \
 && find /opt/synopsys/lc/X-2025.06 -name 'libcrypto.so.1.1*' -delete \
 && rm -rf /opt/synopsys/lc/X-2025.06/doc /opt/synopsys/lc/X-2025.06/cdpl/doc

FROM ${RUNTIME_IMAGE}

COPY --from=build /opt/synopsys/lc/X-2025.06 /opt/synopsys/lc/X-2025.06

ENV LC_HOME=/opt/synopsys/lc/X-2025.06 \
    PATH=/opt/synopsys/lc/X-2025.06/bin:$PATH \
    LC_STARTUP_CHECKOUT_LIC=1

# LC builds the hostid for its startup license checkout by enumerating /sys
# through libudev.  In a container that enumeration aborts the tool with
# "realloc(): invalid pointer" (error code 6, then 11): libudev and the
# SCL/FlexLM code bundled in libFWMerge.so disagree on symbol resolution, so
# libudev passes a pointer it got from the tool's strdup to libc's realloc.
# Loading libudev up front makes its symbols resolve to its own copy again.
# This is the standard workaround for FlexLM-based tools in containers
# (systemd issue #19733, Quartus II / FlexNet Publisher in Docker).
# Without it lc_shell dies right after "Initializing..." as soon as a license
# server is configured; with no license server at all it merely reports
# LCSH-5, which is why the crash only shows up on a licensed host.
ENV LD_PRELOAD=/lib64/libudev.so.1

# Start probe last; tmpfs /tmp and /root keep its logs out of the image.
COPY smoke.sh /opt/eda-smoke/smoke.sh
RUN --mount=type=tmpfs,target=/tmp \
    --mount=type=tmpfs,target=/root \
    chmod 0755 /opt/eda-smoke/smoke.sh \
 && /opt/eda-smoke/smoke.sh

WORKDIR /work
ENTRYPOINT ["lc_shell"]
