# Synopsys Formality X-2025.06 (linux64), license checked out from a remote
# SCL/FlexLM server.
#
# Both stages come from base/ (see base/Containerfile.build / .runtime):
#   build:8.10   Synopsys Installer, ValidationTool, SI_ACCEPT_LICENSE=1
#   runtime:8.10 X11/GL/libstdc++/FlexLM runtime libraries
#
# Its ELF tree needs nothing beyond runtime: every unmet soname left in the
# installed tree belongs to the Qt GUI plugins and the bundled Python's optional
# C extensions (icu 56, tcl/tk 8.5, ncursesw 5), none of which exist on el8 and
# none of which the shell flow loads.
ARG EDABASE=local.io/synopsys
ARG BUILD_IMAGE=${EDABASE}/build:8.10
ARG RUNTIME_IMAGE=${EDABASE}/runtime:8.10

FROM ${BUILD_IMAGE} AS build

COPY fm_vX-2025.06_common.spf fm_vX-2025.06_linux64.spf /tmp/src/

RUN /opt/synopsys-installer/batch_installer -allprods -source /tmp/src \
        -target /opt/synopsys -install_as_root > /tmp/install.log 2>&1; \
    rc=$?; tail -30 /tmp/install.log; echo "install_rc=$rc"; \
    test -d /opt/synopsys/fm/X-2025.06

RUN ValidationTool -a -d /opt/synopsys/fm/X-2025.06

# FM ships an el7-era libk5crypto in shlib/export and its RPATH puts that
# directory ahead of /lib64, while libkrb5/libgssapi_krb5 come from
# runtime's krb5-libs (el8).  The mismatch aborts every fm_shell start with
#   /lib64/libkrb5.so.3: undefined symbol: krb5int_c_deprecated_enctype,
#   version k5crypto_3_MIT
# Dropping the bundled copy lets the matching system libk5crypto be used, the
# same fix lc/2025.06/Containerfile applies to LC.  libssl.so.10 stays: nothing else
# provides it and it links the system GSSAPI, which is the point.  The bundled
# shlib/libcrypto.so.1.1 is not in the shadowing shlib/export RPATH, so it stays
# (see README, "Bundled crypto").
RUN find /opt/synopsys/fm/X-2025.06 -name 'libk5crypto.so.3*' -delete

FROM ${RUNTIME_IMAGE}

COPY --from=build /opt/synopsys/fm/X-2025.06 /opt/synopsys/fm/X-2025.06

ENV SYNOPSYS=/opt/synopsys \
    PATH=/opt/synopsys/fm/X-2025.06/bin:$PATH

# FM builds the hostid for its FlexLM checkout by enumerating /sys through
# libudev; in a container that enumeration aborts the tool with
# "realloc(): invalid pointer" (SIGABRT, error code 6) right after startup.
# Loading libudev up front makes its symbols resolve to its own copy again, the
# same workaround lc/2025.06/Containerfile documents at length.
ENV LD_PRELOAD=/lib64/libudev.so.1

# --- start probe ----------------------------------------------------------
# Run the packaged probe as the last build step, so a tree that cannot start
# never reaches the registry.  /tmp and /root are tmpfs for this step: the
# tools keep their command logs and license cache there and none of that
# belongs in the image.  Re-run the probe against the finished image with
#   nerdctl run --rm --entrypoint /opt/eda-smoke/smoke.sh <image>
COPY smoke.sh /opt/eda-smoke/smoke.sh
RUN --mount=type=tmpfs,target=/tmp \
    --mount=type=tmpfs,target=/root \
    chmod 0755 /opt/eda-smoke/smoke.sh \
 && /opt/eda-smoke/smoke.sh

# The image entry point is the tool itself: a pod without a command, or
# `nerdctl run -it <image>`, lands in the fm_shell prompt, and extra arguments
# are passed straight through (`nerdctl run --rm <image> -f run.tcl`).  Use
# `--entrypoint /bin/bash` (or `command: ["bash"]` in a pod) for a shell.
WORKDIR /work
ENTRYPOINT ["fm_shell"]
